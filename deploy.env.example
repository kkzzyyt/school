# Copy this file to deploy.env for the legacy local SSH publisher.
# Production GitHub Actions uses the Docker image workflow in
# .github/workflows/ci-cd.yml and its production Environment variables.
DEPLOY_TARGET=deploy@example.com
DEPLOY_PORT=22
DEPLOY_PATH=/www/wwwroot/school.19soul.cn
# Required: contains only host keys verified through an independent trusted channel.
DEPLOY_KNOWN_HOSTS_FILE=/Users/you/.ssh/school-known_hosts

# The production .env is created and maintained on the server; it is never uploaded.
# DEPLOY_ENV_PATH=/www/wwwroot/school.19soul.cn/.env

# Optional SSH and PM2 settings for the legacy source publisher.
# DEPLOY_RUNTIME=pm2
# DEPLOY_PROXY_COMMAND=nc -x 127.0.0.1:7897 -X 5 %h %p
# DEPLOY_IDENTITY_FILE=/Users/you/.ssh/id_ed25519
# DEPLOY_APP_NAME=school
# DEPLOY_APP_PORT=3000
# DEPLOY_NPM_BIN=/usr/bin/npm
# DEPLOY_HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
# DEPLOY_KEEP_RELEASES=5
# DEPLOY_BATCH_MODE=false

# For a preconfigured systemd service, release staging builds Linux dependencies before
# the service stops. The unit must use DEPLOY_APP_PATH as WorkingDirectory; its runtime
# .env stays outside that directory so both the new app and rollback can use it.
# DEPLOY_RUNTIME=systemd
# DEPLOY_SERVICE=school-next.service
# DEPLOY_APP_PATH=/www/wwwroot/school.19soul.cn/school
# DEPLOY_ENV_PATH=/www/wwwroot/school.19soul.cn/.deploy/runtime.env
